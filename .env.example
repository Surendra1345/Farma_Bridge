# Settings for `docker compose` (copy to .env next to docker-compose.yml).

# Required ----------------------------------------------------------------
# Long random strings, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Letters and digits only, or URL-encode special characters (it goes into a URL).
POSTGRES_PASSWORD=

# Optional ----------------------------------------------------------------
POSTGRES_DB=farma_bridge
POSTGRES_USER=farma
# Host ports (change them if something else already uses them)
FRONTEND_PORT=8080
BACKEND_PORT=8200
POSTGRES_PORT=5434
# Must match the address you open the web app on
CORS_ORIGINS=http://localhost:8080
ADMIN_EMAILS=
# true = send real sign-in emails via Gmail SMTP (needs an app password)
OTP_EMAIL_ENABLED=false
EMAIL_ADDRESS=
EMAIL_PASSWORD=
