# Settings for `docker compose` (copy to .env next to docker-compose.yml).

# Required ----------------------------------------------------------------
# Long random strings, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Letters and digits only, or URL-encode special characters (it goes into a URL).
POSTGRES_PASSWORD=

# Optional ----------------------------------------------------------------
POSTGRES_DB=farma_bridge
POSTGRES_USER=farma
# Host ports (change them if something else already uses them)
FRONTEND_PORT=8080
BACKEND_PORT=8200
POSTGRES_PORT=5434
# Must match the address you open the web app on
CORS_ORIGINS=http://localhost:8080
ADMIN_EMAILS=
# production = refuse to start without JWT_SECRET and hide /docs
APP_ENV=development
# true = also email owners about new orders/bookings and status changes (needs EMAIL_ADDRESS/EMAIL_PASSWORD)
NOTIFY_EMAIL_ENABLED=false

# Crop Doctor (AI crop-disease check from photos, powered by Groq). Leave GROQ_API_KEY empty to keep it switched off.
# Get a key at https://console.groq.com . The default vision model is a Groq "preview" model that Groq may change;
# check https://console.groq.com/docs/vision for the current one and set CROP_DOCTOR_MODEL / CROP_DOCTOR_MAX_IMAGES to match.
GROQ_API_KEY=
CROP_DOCTOR_MODEL=qwen/qwen3.8-27b
CROP_DOCTOR_MAX_IMAGES=3
CROP_DOCTOR_PER_HOUR=10

# Farma Bridge assistant (the chat bubble that explains the app; also powered by Groq and the same GROQ_API_KEY).
# ASSISTANT_MODEL writes the answers, ASSISTANT_GUARD_MODEL decides whether a question is about the app.
# Messages per IP address per 10 minutes (the chat is public, so this keeps costs bounded).
ASSISTANT_MODEL=openai/gpt-oss-120b
ASSISTANT_GUARD_MODEL=openai/gpt-oss-20b
ASSISTANT_PER_10MIN=30
