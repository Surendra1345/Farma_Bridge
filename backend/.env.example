# PostgreSQL example (recommended outside local development)
DATABASE_URL=postgresql+psycopg2://postgres:change-me@localhost:5432/farma_bridge

# SMTP is optional.  If omitted, OTP delivery is simulated locally.
EMAIL_ADDRESS=
EMAIL_PASSWORD=
OTP_EMAIL_ENABLED=false

# Auth: long random string used to sign login tokens (python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=
# Optional: comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: comma-separated emails allowed to resolve user reports
ADMIN_EMAILS=
